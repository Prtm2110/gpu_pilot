# Systemd service configuration for GPU Scaler
[Unit]
Description=GPU Auto-Scaler Service for HPC Clusters
Documentation=https://github.com/Prtm2110/gpu_pilot
After=network.target
Wants=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/lord_grivous/Desktop/personal_projects/gpu_pilot/scaler
Environment=PATH=/home/lord_grivous/Desktop/personal_projects/gpu_pilot/scaler/venv/bin
Environment=PYTHONPATH=/home/lord_grivous/Desktop/personal_projects/gpu_pilot/scaler
Environment=SCALER_SECRET_TOKEN=your-secret-token-here
Environment=TERRAFORM_DIR=/home/lord_grivous/Desktop/personal_projects/gpu_pilot/terraform-scale

# Main process
ExecStart=/home/lord_grivous/Desktop/personal_projects/gpu_pilot/scaler/venv/bin/python scaler.py

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gpu-scaler

# Restart policy
Restart=always
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log /tmp

[Install]
WantedBy=multi-user.target
